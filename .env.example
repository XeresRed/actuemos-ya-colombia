# ==============================================================================
# .env.example: Plantilla de Variables de Entorno para Desarrollo Local
# ==============================================================================

# Entorno y Servidor
NODE_ENV=development
PORT=3000
DATABASE_URL=./data/database.sqlite
APP_DOMAIN=localhost:3000

# Seguridad de Sesión (Firma criptográfica HMAC-SHA256 de cookies administrativas)
SESSION_SECRET=generar_un_secreto_seguro_minimo_32_caracteres

# Administrador Semilla
ADMIN_DEFAULT_EMAIL=cam960210@gmail.com
ADMIN_MASTER_PASSWORD=tu_contrasena_maestra_segura
AUTO_SEED=false

# Anti-Bot (Cloudflare Turnstile prioritario / reCAPTCHA v3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...tu_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...tu_secret_key
# RECAPTCHA_SITE_KEY=test_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=test_recaptcha_secret_key

# Google Tag Manager / GA4 (Opcional)
NEXT_PUBLIC_GTM_ID=GTM-W4VM7KCD


# Servicio de Correo Transaccional (Resend API prioritario / MailerSend / SMTP Fallback)
RESEND_API_KEY=re_tu_api_key_de_resend
# MAILERSEND_API_KEY=mlsn.tu_api_key
EMAIL_FROM=onboarding@resend.dev

# Fallback SMTP Opcional
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=tu_api_key

# Certificados SSL Automáticos (Caddy)
ACME_EMAIL=cam960210@gmail.com
