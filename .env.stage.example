# ==============================================================================
# .env.stage.example: Configuración de Variables de Entorno para Staging
# ==============================================================================

# Entorno y Red
NODE_ENV=production
PORT=3000
DATABASE_URL=/data/database.sqlite
APP_DOMAIN=stage.actuemosya.org
ACME_EMAIL=admin@actuemosya.org

# Anti-Bot (reCAPTCHA v3 / Cloudflare Turnstile)
RECAPTCHA_SITE_KEY=tu_recaptcha_site_key_staging
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key_staging

# Servicio de Correo Transaccional (Magic Links & Códigos OTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_tu_api_key_staging
EMAIL_FROM=no-reply@actuemosya.org
