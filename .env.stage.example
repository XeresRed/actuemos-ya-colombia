# ==============================================================================
# .env.stage.example: Configuración de Variables de Entorno para Staging / Producción
# ==============================================================================

# Entorno y Red
NODE_ENV=production
PORT=3000
DATABASE_URL=/data/database.sqlite
APP_DOMAIN=actuayacolombia.org

# Seguridad de Sesión (Firma criptográfica HMAC-SHA256 de cookies administrativas)
SESSION_SECRET=generar_un_secreto_seguro_minimo_32_caracteres

# Administrador Semilla y Auto-Sembrado
ADMIN_DEFAULT_EMAIL=cam960210@gmail.com
AUTO_SEED=false

# Anti-Bot (Cloudflare Turnstile prioritario / reCAPTCHA v3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu_turnstile_site_key_staging
TURNSTILE_SECRET_KEY=tu_turnstile_secret_key_staging
# RECAPTCHA_SITE_KEY=tu_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key

# Servicio de Correo Transaccional (Resend API prioritario / MailerSend / SMTP)
RESEND_API_KEY=re_tu_api_key_de_resend
# MAILERSEND_API_KEY=mlsn.tu_api_key
EMAIL_FROM=onboarding@resend.dev

# Fallback SMTP Opcional
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=tu_api_key

# Certificados SSL Automáticos (Caddy)
ACME_EMAIL=cam960210@gmail.com
